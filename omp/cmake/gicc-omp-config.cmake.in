# gicc-omp-config.cmake - find_package(gicc-omp) => gicc::omp, gicc::omp_dwq.
@PACKAGE_INIT@
set(GICC_OMP_ROOT   "@GICC_ROOT@")
set(GICC_OMP_LIBDIR "@GICC_ROOT@/build_ofi/lib")
# ROCm 6.4.0 clang toolchain (same LLVM the pass plugin is built against, so the
# DWQ path can load -fpass-plugin and link this library with one compiler).
set(GICC_OMP_ROCM   "/opt/rocm-6.4.0")
set(GICC_OMP_LIBFAB "/opt/cray/libfabric/2.1")
set(GICC_OMP_MPI    "/opt/cray/pe/mpich/9.0.1/ofi/cray/20.0")
set(GICC_OMP_OMPLIB "/opt/rocm-6.4.0/lib/llvm/lib")
set(GICC_OMP_CRAYPE "/opt/cray/pe/lib64")
set(GICC_OMP_PASS   "@GICC_ROOT@/tools/gicc-passes/build/libgicc-passes.so")

add_library(gicc::omp INTERFACE IMPORTED)
target_include_directories(gicc::omp INTERFACE
    "${GICC_OMP_ROOT}" "${GICC_OMP_ROOT}/src"
    "${GICC_OMP_ROOT}/src/gicc/platform/ofi/internal"
    "${GICC_OMP_ROCM}/include" "${GICC_OMP_LIBFAB}/include")
target_compile_options(gicc::omp INTERFACE
    -fopenmp --offload-arch=gfx90a
    -DGICC_BOOTSTRAP_MPI=1 -DGICC_PLATFORM_OFI -DGICC_GPU_HIP=1 -DGICC_CPU_PROXY=1
    -D__HIP_PLATFORM_AMD__=1 -D__HIP_ROCclr__=1)
target_link_libraries(gicc::omp INTERFACE
    "${GICC_OMP_LIBDIR}/libgicc_omp.so"
    "${GICC_OMP_LIBFAB}/lib64/libfabric.so" /usr/lib64/libhwloc.so -lpthread
    "${GICC_OMP_ROCM}/lib/libamdhip64.so" "${GICC_OMP_MPI}/lib/libmpi_cray.so"
    "${GICC_OMP_OMPLIB}/libomptarget.so")
target_link_options(gicc::omp INTERFACE
    -fopenmp --offload-arch=gfx90a --rtlib=compiler-rt -unwindlib=libgcc
    "-Wl,--allow-shlib-undefined"
    "-Wl,-rpath,${GICC_OMP_LIBDIR}:${GICC_OMP_LIBFAB}/lib64:${GICC_OMP_MPI}/lib:${GICC_OMP_OMPLIB}:${GICC_OMP_ROCM}/lib:${GICC_OMP_CRAYPE}")

# DWQ variant: same link surface + the compile-time pass flags. The
# -openmp-opt-disable is CRITICAL: without it OpenMPOpt argument-specializes the
# put marker's constant operands away, so the host trace would enqueue a
# zero-byte DWQ write. Requires GICC_MODE=omp-dwq + GICC_META_DIR in the env at
# compile time, and a two-pass compile (the pass populates then consumes JSON).
add_library(gicc::omp_dwq INTERFACE IMPORTED)
target_link_libraries(gicc::omp_dwq INTERFACE gicc::omp)
target_compile_options(gicc::omp_dwq INTERFACE
    -DGIOMP_ENABLE_DWQ -foffload-lto "-fpass-plugin=${GICC_OMP_PASS}"
    -mllvm -openmp-opt-disable=true)
